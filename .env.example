# Copy to .env for local development. Never commit .env.
# These Supabase values are public client configuration; enable strict RLS
# and never put a service-role key in a VITE_* variable.
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Optional server-side key for built-in AI gateway features.
# Keep this server-only; do not prefix it with VITE_.
LOVABLE_API_KEY=
